# Copy to .env.local and fill in real values. Never commit .env.local.
# Outside production, every variable below is optional: with none set, the
# app runs against the in-memory demo repository and mock adapters (see
# src/server/repo.ts, src/server/repo.tanstack.ts, src/adapters/index.ts).

# --- Supabase (data layer + auth) ---
# Both required together to switch from the in-memory demo repo to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never exposed to the client. Required in production.
SUPABASE_SERVICE_ROLE_KEY=

# Outside production only: force "memory" or "supabase" regardless of the
# Supabase vars above. Production always uses supabase and ignores this.
DATA_PROFILE=

# --- Adapters (src/adapters/index.ts) ---
# Outside production: "live" opts into the real Gmail SMTP adapter; default
# is mock. Production always uses the real adapter regardless of this var.
ADAPTER_PROFILE=
# Set to "aisensy" to enable the real WhatsApp adapter (defaults to mock,
# even in production -- see src/adapters/index.ts for why).
WHATSAPP_PROVIDER=

# --- Email provider (src/adapters/index.ts) ---
# Real email needs an EXPLICIT provider; it is never guessed from which
# credentials exist. Unset/unknown = fail closed (nothing is sent).
#   gmail-api  -> Gmail REST API over HTTPS. REQUIRED for hosted / Cloudflare Worker production.
#   gmail-smtp -> Nodemailer + App Password. Self-hosted Node / local only; refused on Workers.
EMAIL_PROVIDER=

# --- Gmail API (src/lib/config/gmail-api.ts) -- EMAIL_PROVIDER=gmail-api ---
# All server-only secrets/config: never NEXT_PUBLIC_ / VITE_ prefixed, never committed.
# GOOGLE_REFRESH_TOKEN comes from a one-time human OAuth consent (scope gmail.send).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=

# --- Gmail SMTP (src/lib/config/email.ts) -- EMAIL_PROVIDER=gmail-smtp only ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=

# --- AiSensy WhatsApp (src/lib/config/aisensy.ts) ---
AISENSY_API_KEY=
AISENSY_SEND_TIMEOUT_MS=
