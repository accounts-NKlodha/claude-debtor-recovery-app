# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build output
/.next/
/out/
/src-tauri/target/
.env*.local
.env

# test artefacts (Playwright)
/test-results/
/playwright-report/
/blob-report/

# auto-generated by `next dev` (agentRules) -- not hand-authored, don't track
/AGENTS.md
/CLAUDE.md

# Supabase CLI local link cache (machine-specific, regenerable via `supabase link`)
/supabase/.temp/

# Supabase CLI local branch-tracking state (created by `supabase start`,
# machine-local, regenerable)
/supabase/.branches/

# Database backups (disaster-recovery task) -- logical dumps of production
# data, never committed. See docs/disaster-recovery/index.md.
/backups/
